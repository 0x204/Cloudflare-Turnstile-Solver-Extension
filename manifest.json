{
  "manifest_version": 3,
  "minimum_chrome_version": "128",
  "name": "Cloudflare Turnstile Solver",
  "version": "2.0.1",
  "description": "Automatically handles interactive Cloudflare Turnstile widgets.",
  "permissions": ["debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://challenges.cloudflare.com/*",
        "https://challenges.fed.cloudflare.com/*",
        "https://challenges-staging.cloudflare.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
