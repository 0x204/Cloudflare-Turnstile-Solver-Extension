{
	"manifest_version": 3,
	"minimum_chrome_version": "128",
	"name": "Cloudflare Turnstile Solver",
	"version": "2.2.0",
	"description": "Automatically handles interactive Cloudflare Turnstile widgets.",
	"permissions": ["debugger", "storage"],
	"background": {
		"service_worker": "background/index.js",
		"type": "module"
	},
	"icons": {
		"16": "icons/logo.png",
		"48": "icons/logo.png",
		"128": "icons/logo.png"
	},
	"content_scripts": [
		{
			"matches": [
				"https://challenges.cloudflare.com/*",
				"https://challenges.fed.cloudflare.com/*",
				"https://challenges-staging.cloudflare.com/*"
			],
			"js": ["content/screen-coords.js"],
			"run_at": "document_start",
			"all_frames": true,
			"world": "MAIN"
		},
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["shared.js", "content/relay.js"],
			"run_at": "document_start",
			"all_frames": true,
			"match_origin_as_fallback": true
		}
	]
}
